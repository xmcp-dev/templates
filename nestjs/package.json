{
  "name": "xmcp-nestjs",
  "version": "0.1.0",
  "private": true,
  "description": "A NestJS server with xmcp adapter integration",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "xmcp build && nest build",
    "dev": "xmcp dev & nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.2",
    "typescript": "^5.9.3",
    "xmcp": "latest"
  }
}

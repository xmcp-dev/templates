# Credentials
# Bare Descope issuer URL — no /.well-known suffix, the provider appends it itself
DESCOPE_ISSUER_URL=https://api.descope.com/v1/apps/agentic/<project-id>/<mcp-server-id>

# App configuration
# Must be the full MCP endpoint URL (including /mcp) — Descope whitelists this
# exact value as the OAuth "resource"/audience for dynamically registered clients.
BASE_URL=http://127.0.0.1:3001/mcp

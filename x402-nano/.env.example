# nano_ address to receive XNO payments (required; checked on start)
X402_NANO_WALLET=nano_YOUR_ADDRESS_HERE

# Optional: Nano node RPC used to read payment blocks (defaults to https://rpc.nano.to)
# NANO_RPC_URL=https://rpc.nano.to

# Optional: file that records used block hashes across restarts (defaults to ./nano-claims.txt)
# NANO_CLAIMS_FILE=/var/lib/my-server/nano-claims.txt
